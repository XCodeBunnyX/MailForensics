# GmailGuard Environment Variables
# Copy this file to backend/.env and fill in your API keys.
# Never commit backend/.env to Git.

# ── IP Geolocation (IPinfo) ───────────────────────────────────────
# Free tier: 50,000 requests/month
# Sign up: https://ipinfo.io/signup
IPINFO_TOKEN=your_ipinfo_token_here

# ── URL Dynamic Sandbox (urlscan.io) ─────────────────────────────
# Free tier available
# Sign up: https://urlscan.io/user/signup
URLSCAN_API_KEY=your_urlscan_api_key_here
URLSCAN_ENABLED=true
MOCK_URLSCAN=false

# ── Domain / Forensic Intelligence ───────────────────────────────
# Set MOCK_THREAT_INTEL=false and supply one of the keys below to use live providers.
# Default: mock/demo mode (no API key required).
MOCK_THREAT_INTEL=true
FORENSIC_PROVIDER=virustotal

# VirusTotal (free tier: 4 requests/min)
# Sign up: https://www.virustotal.com/gui/join-us
VIRUSTOTAL_API_KEY=your_virustotal_api_key_here

# SecurityTrails (alternative forensic DNS history provider)
# Sign up: https://securitytrails.com/
SECURITYTRAILS_API_KEY=your_securitytrails_api_key_here

# ── OSINT Intelligence ────────────────────────────────────────────
# Default: mock/demo mode.
MOCK_OSINT=true
OSINT_SCORE_WEIGHT=0.0

# ── PhishTank URL Intelligence ────────────────────────────────────
# Default: mock/demo mode.
MOCK_PHISHTANK=true
# Sign up: https://www.phishtank.com/api_info.php
PHISHTANK_API_KEY=your_phishtank_api_key_here
