# GmailGuard Environment Variables
# Copy this file to backend/.env and fill in your API keys.
# Never commit backend/.env to Git.

# ── IP Geolocation (IPinfo) ───────────────────────────────────────
# Free tier: 50,000 requests/month
# Sign up: https://ipinfo.io/signup
IPINFO_TOKEN=your_ipinfo_token_here

# ── Local Browserless Sandbox (Chromium Docker) ───────────────────
# Run Docker container:
# docker run -d --rm -p 3000:3000 -e "TOKEN=gmailguard-local" -e "CONCURRENT=2" -e "TIMEOUT=60000" --shm-size=2g ghcr.io/browserless/chromium
BROWSERLESS_URL=http://localhost:3000
BROWSERLESS_TOKEN=gmailguard-local
BROWSER_SANDBOX_ENABLED=true
BROWSER_SANDBOX_TIMEOUT=60000
BROWSER_SANDBOX_MAX_URLS=3
MOCK_URLSCAN=false


# ── Domain / Forensic Intelligence ───────────────────────────────
# Set MOCK_THREAT_INTEL=false and supply one of the keys below to use live providers.
# Default: mock/demo mode (no API key required).
MOCK_THREAT_INTEL=true
FORENSIC_PROVIDER=virustotal

# VirusTotal (free tier: 4 requests/min)
# Sign up: https://www.virustotal.com/gui/join-us
VIRUSTOTAL_API_KEY=your_virustotal_api_key_here

# SecurityTrails (alternative forensic DNS history provider)
# Sign up: https://securitytrails.com/
SECURITYTRAILS_API_KEY=your_securitytrails_api_key_here

# ── OSINT Intelligence ────────────────────────────────────────────
# Default: mock/demo mode.
MOCK_OSINT=true
OSINT_SCORE_WEIGHT=0.0

# ── PhishTank URL Intelligence ────────────────────────────────────
# Default: mock/demo mode.
MOCK_PHISHTANK=true
# Sign up: https://www.phishtank.com/api_info.php
PHISHTANK_API_KEY=your_phishtank_api_key_here

# ── Gemini AI Security Intelligence (Google GenAI) ────────────────
# Generates structured LLM reasoning, social engineering detection, and SOC recommendations.
# Get free API key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash

# ── Official Gmail API & OAuth 2.0 Integration ────────────────────
# Create OAuth 2.0 Web Application credentials in Google Cloud Console:
# 1. Enable Gmail API at https://console.cloud.google.com/apis/library/gmail.googleapis.com
# 2. Configure OAuth Consent Screen (Internal or External test users)
# 3. Create Credentials -> OAuth client ID -> Web application
# 4. Authorized redirect URI: http://localhost:8000/api/gmail/oauth2callback
GMAIL_CLIENT_ID=your_google_oauth_client_id_here.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=your_google_oauth_client_secret_here
GMAIL_REDIRECT_URI=http://localhost:8000/api/gmail/oauth2callback
# Optional path to downloaded client_secret_*.json
GMAIL_CREDENTIALS_FILE=
